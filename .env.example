# Port the local dev server listens on (dev only — unused on Vercel).
PORT=3002

# Origin of the search/talisman API. Required — the app throws at startup without it.
# `BUN_PUBLIC_*` vars are inlined into the browser bundle at BUILD time, so they must be
# set wherever `bun run build` runs (locally: `.env`; on Vercel: Project Settings →
# Environment Variables). Never put a secret behind this prefix — it ships to the client.
BUN_PUBLIC_API_BASE_URL=http://localhost:3003

# Same Supabase project as enlightened-fellows-discord-bot (its Auth Hook stamps
# app_metadata.discord_id into the JWT that API expects — see its docs/adr/0003).
BUN_PUBLIC_SUPABASE_URL=
BUN_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cd5r20NUoyi-FoVTFlBIrA_IEntVG0K
